# Local backend configuration. Values containing credentials stay blank.
DATABASE_URL=
APP_URL=http://localhost:5173
GMAIL_REDIRECT_URI=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Haveloc access and scan interval. Scanning remains paused in this read-only phase.
HAVELOC_BASE_URL=https://placements.haveloc.com/
HAVELOC_USERNAME=
HAVELOC_PASSWORD=
HAVELOC_SCAN_INTERVAL_MINUTES=30

# Gmail OAuth is read-only and polling stays off until separately enabled in Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=

# AI classification is inactive until a supported provider key is configured.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# In-app notifications may be enabled; external email starts disabled.
NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_RECIPIENT=

# WhatsApp Cloud notifications remain off until explicitly enabled and configured.
WHATSAPP_ENABLED=
WHATSAPP_PROVIDER=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_NUMBER=
